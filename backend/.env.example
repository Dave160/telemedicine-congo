# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/telemedicine_congo

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_REFRESH_SECRET=change-me-to-another-long-random-secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Africa's Talking (SMS/OTP) — laisser vide pour simulation locale en dev
AT_API_KEY=
AT_USERNAME=sandbox
AT_SENDER_ID=TELECONGO

# MTN Mobile Money (sandbox)
MTN_COLLECTION_USER_ID=
MTN_COLLECTION_API_KEY=
MTN_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_SUBSCRIPTION_KEY=

# Airtel Money (sandbox)
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=

AIRTEL_COUNTRY=CG
AIRTEL_CURRENCY=XAF

# Cloudinary (upload PDF + images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# WhatsApp (optionnel - Twilio ou WhatsApp Business API)
